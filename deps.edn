{:paths   ["src"]
 :deps    {borkdude/edamame            {:mvn/version "1.4.32"}
           com.nextjournal/beholder    {:mvn/version "1.0.3"}
           com.stuartsierra/dependency {:mvn/version "1.0.0"}
           fipp/fipp                   {:mvn/version "0.6.29"}
           meander/epsilon             {:mvn/version "0.0.650"}
           org.clj-commons/pretty      {:mvn/version "3.6.3"}
           org.clojure/data.json       {:mvn/version "2.5.1"}
           org.clojure/tools.logging   {:mvn/version "1.3.0"}}

 :tools/usage
 {:ns-default tools.graphql.api}

 :aliases {:cli   {:extra-deps {org.clojure/tools.cli {:mvn/version "1.1.230"}}}
           :build {:deps       {io.github.clojure/tools.build {:mvn/version "RELEASE"}
                                slipset/deps-deploy           {:mvn/version "RELEASE"}}
                   :ns-default build}
           :test  {:extra-paths ["test" "test-resources"]
                   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                       :git/sha "dfb30dd"}}
                   :exec-fn     cognitect.test-runner.api/test}}}
